{
  "name": "mercadobra-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:production": "npm run migrate && npm run db:check && node src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "db:bootstrap": "npm run migrate && npm run seed",
    "db:check": "node src/dbCheck.js",
    "admin:bootstrap": "node src/bootstrapAdmin.js",
    "images:migrate": "node src/migrateProductImages.js",
    "costs:seed": "node src/seedCostVariables.js",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
